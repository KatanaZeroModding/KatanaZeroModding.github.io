{
  "name": "kzm-bar",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "bun --bun vite dev --host 127.0.0.1",
    "build": "bun --bun vite build",
    "preview": "bun --bun vite preview --host 127.0.0.1",
    "check": "bun --bun svelte-kit sync && bun --bun svelte-check --tsconfig ./tsconfig.json",
    "check:i18n": "inlang check --project ./project.inlang"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.0",
    "@fontsource/tiny5": "^5.3.0",
    "@lucide/svelte": "^1.66.0"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "^2.29.3",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.48.0",
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.10.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "@inlang/cli": "^3.4.0"
  }
}
